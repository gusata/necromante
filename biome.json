{
  "files": { "includes": ["src/**", "tests/**", "scripts/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "noParameterAssign": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noAssignInExpressions": "off", "useIterableCallbackReturn": "off" }
    }
  }
}
